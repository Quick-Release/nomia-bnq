---
import { type DesignTheme, type Alternate, type SiteChrome, type SiteLanguage } from "@getquick/content";
import { consentPage } from "@getquick/content/consent/astro";
import DesignPresentationStyles from "../components/DesignPresentationStyles.astro";
import DesignPatternRegion from "../components/DesignPatternRegion.astro";
import { content } from "../lib/content";
import { copyFor } from "../lib/copy";
import "../styles/global.css";

interface Props {
  title?: string;
  theme?: DesignTheme;
  description?: string;
  /** The chrome the page was served with; left out, the layout looks it up. */
  chrome?: SiteChrome | null;
  /** The page's language; left out, the site's default language. */
  language?: SiteLanguage;
  /** Where its readers may switch language (a multilingual Site's pages only). */
  alternates?: Alternate[];
}

const runtime = content();
const {
  title = "Nomia",
  description = "",
  language = runtime.defaultLanguage,
  alternates = [],
} = Astro.props;
const chrome =
  Astro.props.chrome !== undefined
    ? Astro.props.chrome
    : await runtime.pageChrome(Astro.site?.origin);
// Chrome that can't be served leaves the menu, logo and icon out of this
// response only; it doesn't mean the site has none, so the page is still served.
const { menuItems, siteIcon, siteLogo } = chrome ?? {
  menuItems: [],
  siteIcon: null,
  siteLogo: null,
};
// The header and footer editors select in GQ Design's Header & Footer, as the
// chrome serves them; null when it serves none (a template part, nothing
// published selected, or no chrome), and the layout keeps its own. A pattern
// draws the whole bar (the Nomia navigation sticks to the page), so its
// header box takes no layout of its own (`contents`).
const headerPattern = chrome?.header ?? null;
const footerPattern = chrome?.footer ?? null;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
// The page and its published translations, in the site's language order,
// each under its language's tag, then the default language's as x-default.
const translations = alternates.filter((alternate) => alternate.translation);
const hreflang =
  translations.length === 0
    ? []
    : runtime.languages.flatMap((siteLanguage) => {
        if (siteLanguage.slug === language.slug) return [{ language: siteLanguage, href: canonical.href }];
        const translation = translations.find(
          (alternate) => alternate.language.slug === siteLanguage.slug,
        );
        return translation
          ? [{ language: siteLanguage, href: new URL(translation.route, Astro.site ?? Astro.url).href }]
          : [];
      });
const xDefault = hreflang.find((alternate) => alternate.language.isDefault);
// CONSENT-1 and LEGAL-1 (docs/adr/0001): the Runtime's banner first in the
// body, open only without a decision in force, and its legal links and Cookie
// settings control in the footer, from the chrome the page was served with.
const consent = consentPage({
  configuration: runtime.consentConfiguration(chrome)!,
  language: language.lang,
  legal: chrome?.legal ?? null,
  cookie: Astro.request.headers.get("cookie"),
});
---

<!doctype html>
<html lang={language.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={siteIcon?.sourceUrl || "/favicon.svg"} />
    <link rel="canonical" href={canonical} />
    {hreflang.map((alternate) => <link rel="alternate" hreflang={alternate.language.lang} href={alternate.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
    <title>{title === "Nomia" ? title : `${title} — Nomia`}</title>
    <DesignPresentationStyles theme={Astro.props.theme} />
    <Fragment set:html={consent.head} />
  </head>
  <body class="gqd-content">
    <Fragment set:html={consent.body} />
    {headerPattern ? (
      <header class="contents">
        <DesignPatternRegion pattern={headerPattern} language={language} />
        {alternates.length > 0 && (
          <nav class="language-switcher" aria-label={copyFor(language, runtime.multilingual).languages}>
            <ul>
              {alternates.map((alternate) => (
                <li>
                  <a href={alternate.route} hreflang={alternate.language.lang} lang={alternate.language.lang}>
                    {alternate.language.slug.toUpperCase()}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </header>
    ) : (
      <header class="site-header">
        <a href={language.home} class="site-header__home">
          {siteLogo ? <img src={siteLogo.sourceUrl} alt={siteLogo.altText || "Nomia"} /> : "Nomia"}
        </a>
        {menuItems.length > 0 && (
          <nav aria-label="Primary">
            <ul>
              {menuItems.map((item) => (
                <li>
                  <a href={item.href} target={item.target ?? undefined}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {alternates.length > 0 && (
          <nav class="language-switcher" aria-label={copyFor(language, runtime.multilingual).languages}>
            <ul>
              {alternates.map((alternate) => (
                <li>
                  <a href={alternate.route} hreflang={alternate.language.lang} lang={alternate.language.lang}>
                    {alternate.language.slug.toUpperCase()}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </header>
    )}
    <slot />
    <footer class="site-footer">
      {footerPattern && <DesignPatternRegion pattern={footerPattern} language={language} />}
      <Fragment set:html={consent.footer} />
    </footer>
    <script>
      import { startConsent } from "@getquick/content/consent/client";

      startConsent();
    </script>
  </body>
</html>
