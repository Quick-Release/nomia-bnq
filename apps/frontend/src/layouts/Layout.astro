---
import FontLinks from "../components/layout/FontLinks.astro";
import { isLightHexColor } from "../lib/color-contrast";
import { copyFor } from "../lib/copy";
import { pageChrome, pageDesign, type Alternate } from "../lib/delivery";
import { defaultLanguage, languages, type SiteLanguage } from "../lib/site-language";
import { normalizeSectionBackground } from "../lib/section-block";
import type { DesignPresets, SiteChrome } from "../lib/wordpress";
import { presetRootStyle } from "../lib/wp-block-styles";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** The chrome the page was served with; left out, the layout looks it up. */
  chrome?: SiteChrome | null;
  /** The page's language; left out, the site's default language. */
  language?: SiteLanguage;
  /** Where its readers may switch language (a multilingual Site's pages only). */
  alternates?: Alternate[];
  /** The design presets the page was served with; left out, the layout looks them up. */
  design?: DesignPresets | null;
  /** A Nomia page's own surface colour (its "Fundo da página" setting), as a hex colour. */
  pageBackgroundColor?: string | null;
}

const {
  title = "Nomia",
  description = "",
  language = defaultLanguage,
  alternates = [],
  pageBackgroundColor = null,
} = Astro.props;
// The text contrast follows a page's own background, as on bioeconomia.pt.
const background = normalizeSectionBackground(pageBackgroundColor);
const surface = background
  ? { class: isLightHexColor(background) ? "text-neutral-bw-black" : "text-neutral-bw-white", style: `background-color: ${background}` }
  : null;
const chrome =
  Astro.props.chrome !== undefined ? Astro.props.chrome : await pageChrome(Astro.site?.origin);
// Chrome that can't be served leaves the menu, logo and icon out of this
// response only; it doesn't mean the site has none, so the page is still served.
const { menuItems, siteIcon, siteLogo } = chrome ?? {
  menuItems: [],
  siteIcon: null,
  siteLogo: null,
};
// GQ Design's palette and spacing, as WordPress's preset variables on :root.
const design = Astro.props.design !== undefined ? Astro.props.design : await pageDesign();
const presets = design ? presetRootStyle(design.spacingSizes, design.colors) : "";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
// The page and its published translations, in the site's language order,
// each under its language's tag, then the default language's as x-default.
const translations = alternates.filter((alternate) => alternate.translation);
const hreflang =
  translations.length === 0
    ? []
    : languages.flatMap((siteLanguage) => {
        if (siteLanguage === language) return [{ language: siteLanguage, href: canonical.href }];
        const translation = translations.find((alternate) => alternate.language === siteLanguage);
        return translation
          ? [{ language: siteLanguage, href: new URL(translation.route, Astro.site ?? Astro.url).href }]
          : [];
      });
const xDefault = hreflang.find((alternate) => alternate.language.isDefault);
---

<!doctype html>
<html lang={language.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={siteIcon?.sourceUrl || "/favicon.svg"} />
    <link rel="canonical" href={canonical} />
    {hreflang.map((alternate) => <link rel="alternate" hreflang={alternate.language.lang} href={alternate.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
    <title>{title === "Nomia" ? title : `${title} — Nomia`}</title>
    <FontLinks />
    {presets && <style is:global set:html={presets} />}
  </head>
  <body class={surface?.class} style={surface?.style}>
    <header class="site-header">
      <a href={language.home} class="site-header__home">
        {siteLogo ? <img src={siteLogo.sourceUrl} alt={siteLogo.altText || "Nomia"} /> : "Nomia"}
      </a>
      {menuItems.length > 0 && (
        <nav aria-label="Primary">
          <ul>
            {menuItems.map((item) => (
              <li>
                <a href={item.href} target={item.target ?? undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {alternates.length > 0 && (
        <nav class="language-switcher" aria-label={copyFor(language).languages}>
          <ul>
            {alternates.map((alternate) => (
              <li>
                <a href={alternate.route} hreflang={alternate.language.lang} lang={alternate.language.lang}>
                  {alternate.language.slug.toUpperCase()}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </header>
    <slot />
  </body>
</html>
