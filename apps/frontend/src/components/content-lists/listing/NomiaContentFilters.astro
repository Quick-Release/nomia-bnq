---
/**
 * The search box and taxonomy choices of an archive Page. A plain GET form:
 * submitting it reloads the Page with the choices in its address, which the
 * Listing on the Page reads on the server, so it works without JavaScript and
 * every filtered view is a link. Submitting starts again from the first page.
 */
import { LISTING_PARAMS } from "../../../lib/content-collections";
import { PAGE_FRAME } from "../../../lib/site-gutters";

export interface FilterChoice {
  param: string;
  label: string;
  selected: string;
  options: Array<{ slug: string; name: string; count: number }>;
}

interface Props {
  action: string;
  search: string | null;
  choices: FilterChoice[];
  /** The Page's address without filters, when some apply. */
  clearHref: string | null;
}

const { action, search, choices, clearHref } = Astro.props;
const field =
  "border-current/30 focus-visible:ring-main-teal-400 w-full rounded-sm border bg-transparent px-3 py-2 text-base focus-visible:ring-2 focus-visible:outline-none";
---

<section class={`${PAGE_FRAME} font-secondary pt-10 md:pt-12`}>
  <form method="get" action={action} role="search" class="flex flex-col gap-4 md:flex-row md:flex-wrap md:items-end">
    {search !== null && (
      <label class="flex min-w-0 flex-1 flex-col gap-1 md:min-w-64">
        <span class="text-sm font-medium">Pesquisar</span>
        <input type="search" name={LISTING_PARAMS.search} value={search} class={field} />
      </label>
    )}
    {choices.map((choice) => (
      <label class="flex min-w-0 flex-col gap-1 md:w-56">
        <span class="text-sm font-medium">{choice.label}</span>
        <select name={choice.param} class={field}>
          <option value="">Todas</option>
          {choice.options.map((option) => (
            <option value={option.slug} selected={option.slug === choice.selected}>
              {option.name} ({option.count})
            </option>
          ))}
        </select>
      </label>
    ))}
    <div class="flex items-center gap-4">
      <button
        type="submit"
        class="bg-main-ciano-700 text-neutral-bw-white focus-visible:ring-main-teal-400 rounded-sm px-5 py-2 font-semibold focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        Filtrar
      </button>
      {clearHref && (
        <a href={clearHref} class="text-base underline underline-offset-4">
          Limpar filtros
        </a>
      )}
    </div>
  </form>
</section>
