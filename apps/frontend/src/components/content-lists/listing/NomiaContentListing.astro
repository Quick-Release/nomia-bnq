---
/**
 * A collection's items in Nomia's presentations, ported from
 * bioeconomia.pt's archive shells (NomiaCptArchiveShell and the multimedia
 * archive): a list of titles, a grid of thumbnails with the title over the
 * image, a two-column grid with the title above the image, or Biblioteca document cards.
 */
import ListingEnhancements from "./ListingEnhancements.astro";
import { safeHref } from "../../../lib/safe-href";
import type { ListingDisplay } from "../../../lib/content-collections";
import { PAGE_FRAME } from "../../../lib/site-gutters";

export interface ListingRow {
  href: string;
  title: string;
  imageSrc: string | null;
  imageAlt: string;
  year?: number | null;
  publisher?: string;
  description?: string;
  fileUrl?: string;
  pageUrl?: string;
}

export interface ListingPageLink {
  page: number;
  href: string;
  current: boolean;
}

interface Props {
  infiniteLoading?: boolean;
  lightbox?: boolean;
  display: ListingDisplay;
  rows: ListingRow[];
  /** Why there are no rows: nothing published, nothing matches, or the store didn't answer. */
  empty: "none" | "no-match" | "unavailable";
  /** The pages' links, when there is more than one page and the block shows them. */
  pages?: ListingPageLink[];
  previous?: string | null;
  next?: string | null;
}

const { display, rows, empty, pages = [], previous = null, next = null, infiniteLoading = false, lightbox = false } = Astro.props;
const emptyText = {
  none: "Ainda não há entradas publicadas.",
  "no-match": "Nenhum conteúdo corresponde à pesquisa.",
  unavailable: "A lista não está disponível de momento.",
}[empty];
const listClass = {
  "document-grid": "grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3",
  list: "flex flex-col divide-y divide-current/20",
  "thumbnail-grid": "grid gap-5 sm:grid-cols-2 lg:grid-cols-3",
  "titled-thumbnail-grid": "grid gap-x-8 gap-y-12 md:grid-cols-2",
}[display];
const focusRing =
  "focus-visible:ring-main-teal-400 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none";
---

<section class={`${PAGE_FRAME} font-secondary py-10 md:py-12`} data-nomia-content-listing={display} data-infinite={infiniteLoading || undefined} data-lightbox={lightbox || undefined}>
  {rows.length === 0 ? (
    <p class="text-base opacity-70">{emptyText}</p>
  ) : (
    <ul class={listClass} data-listing-rows>
      {rows.map((row) => (
        <li data-listing-item class:list={["min-w-0", display === "list" && "py-4 first:pt-0"]}>
          {display === "document-grid" ? (
            <article class="flex h-full flex-col gap-4">
              <a href={row.href} aria-haspopup={lightbox ? "dialog" : undefined} class:list={["group block rounded-sm", focusRing]}>
                <span class="bg-main-cinza-200 relative flex aspect-video items-center justify-center overflow-hidden rounded-sm">
                  {row.imageSrc ? (
                    <img src={row.imageSrc} alt={row.imageAlt}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy" decoding="async" />
                  ) : (
                    <span class="px-4 text-center text-sm">image not available</span>
                  )}
                </span>
                <h2 class="font-primary mt-4 text-xl leading-snug font-semibold group-hover:underline">
                  {row.title}
                </h2>
              </a>
              {(row.year || row.publisher) && (
                <div class="flex flex-col gap-1 text-sm">
                  {row.year && <p><span class="sr-only">Ano: </span><span>{row.year}</span></p>}
                  {row.publisher && <p><span class="font-medium">Publicado por: </span>{row.publisher}</p>}
                </div>
              )}
              {row.description && <p class="text-base leading-relaxed">{row.description}</p>}
              {(safeHref(row.fileUrl) || safeHref(row.pageUrl)) && (
                <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-2 font-semibold">
                  {safeHref(row.fileUrl) && <a href={safeHref(row.fileUrl)} class:list={["underline underline-offset-4", focusRing]} target="_blank" rel="noopener noreferrer">Consultar PDF<span class="sr-only"> (abre numa nova janela)</span></a>}
                  {safeHref(row.pageUrl) && <a href={safeHref(row.pageUrl)} class:list={["underline underline-offset-4", focusRing]} target="_blank" rel="noopener noreferrer">Visitar página<span class="sr-only"> (abre numa nova janela)</span></a>}
                </div>
              )}
            </article>
          ) : display === "list" ? (
            <a
              href={row.href} aria-haspopup={lightbox ? "dialog" : undefined}
              class:list={[
                "hover:text-main-ciano-500 text-lg font-medium underline-offset-4 transition-colors hover:underline",
                focusRing,
              ]}
            >
              {row.title}
            </a>
          ) : display === "titled-thumbnail-grid" ? (
            <a href={row.href} aria-haspopup={lightbox ? "dialog" : undefined} class:list={["group flex flex-col gap-4 rounded-sm", focusRing]}>
              <h2 class="font-primary text-subtitle font-semibold tracking-[var(--tracking-typography-0)] underline-offset-4 group-hover:underline">
                {row.title}
              </h2>
              <span class="bg-main-cinza-200 relative block aspect-video overflow-hidden rounded-sm">
                {row.imageSrc && (
                  <img
                    src={row.imageSrc}
                    alt={row.imageAlt}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
            </a>
          ) : (
            <a
              href={row.href} aria-haspopup={lightbox ? "dialog" : undefined}
              class:list={[
                "group bg-main-ciano-700 relative flex aspect-video min-h-0 overflow-hidden rounded-sm",
                focusRing,
              ]}
            >
              {row.imageSrc && (
                <img
                  src={row.imageSrc}
                  alt={row.imageAlt}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="from-monochrome-dark-600/90 via-monochrome-dark-600/35 to-monochrome-dark-600/10 absolute inset-0 bg-gradient-to-t transition-opacity group-hover:opacity-95" />
              <span class="text-neutral-bw-white relative mt-auto block p-4 text-lg leading-tight font-semibold">
                {row.title}
              </span>
            </a>
          )}
        </li>
      ))}
    </ul>
  )}
  {infiniteLoading && next && (
    <div class="mt-10" data-listing-loader>
      <a href={next} rel="next" data-listing-more class:list={["inline-block rounded-sm border border-current px-5 py-3", focusRing]}>Carregar mais</a>
      <p role="status" class="mt-3 text-sm" data-listing-status></p>
    </div>
  )}
  {!infiniteLoading && pages.length > 1 && (
    <nav aria-label="Paginação" class="mt-10 flex flex-wrap items-center gap-2 text-base">
      {previous && (
        <a href={previous} rel="prev" class:list={["rounded-sm px-3 py-1 hover:underline", focusRing]}>
          Anterior
        </a>
      )}
      {pages.map((link) =>
        link.current ? (
          <span aria-current="page" class="bg-main-ciano-700 text-neutral-bw-white rounded-sm px-3 py-1 font-semibold">
            {link.page}
          </span>
        ) : (
          <a href={link.href} class:list={["rounded-sm px-3 py-1 hover:underline", focusRing]}>
            {link.page}
          </a>
        ),
      )}
      {next && (
        <a href={next} rel="next" class:list={["rounded-sm px-3 py-1 hover:underline", focusRing]}>
          Seguinte
        </a>
      )}
    </nav>
  )}
  {lightbox && (
    <dialog data-listing-dialog aria-label="Fotografias da galeria" class="listing-dialog">
      <div class="listing-dialog__toolbar">
        <button type="button" data-listing-step="-1" aria-label="Fotografia anterior">←</button>
        <p data-listing-caption aria-live="polite"></p>
        <button type="button" data-listing-step="1" aria-label="Fotografia seguinte">→</button>
        <button type="button" data-listing-close aria-label="Fechar fotografia">×</button>
      </div>
      <img data-listing-image alt="" />
    </dialog>
  )}
</section>

{(lightbox || infiniteLoading) && <ListingEnhancements />}


<style>
  .listing-dialog { background: #111; color: #fff; border: 0; padding: 1rem; width: min(96vw, 1200px); max-height: 94dvh; }
  .listing-dialog::backdrop { background: rgb(0 0 0 / 85%); }
  .listing-dialog__toolbar { display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem; }
  .listing-dialog__toolbar p { flex: 1; }
  .listing-dialog button { cursor: pointer; min-width: 44px; min-height: 44px; font-size: 1.5rem; }
  .listing-dialog button:focus-visible { outline: 3px solid #00a9ce; outline-offset: 2px; }
  .listing-dialog img { display: block; margin: auto; max-width: 100%; max-height: 75dvh; object-fit: contain; }
</style>
