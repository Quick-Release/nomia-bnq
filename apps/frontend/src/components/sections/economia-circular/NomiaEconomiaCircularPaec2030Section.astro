 */

interface Objective {
	code: string;
	description: string;
}

interface Props {
	eyebrow?: string;
	heading: string;
	imageLeftSrc: string;
	imageLeftAlt: string;
	imageRightSrc: string;
	imageRightAlt: string;
	intro: string;
	saberMaisHref: string;
	saberMaisLabel?: string;
