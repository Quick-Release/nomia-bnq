---
import type { ResourceProductivityPoint } from "../../../lib/productivity-chart/types";

interface Props {
  title?: string;
  filterLabels?: string[];
  points: ResourceProductivityPoint[];
  /** Upper bound of the Y axis (Figma default: 2). */
  yMax?: number;
  locale?: string;
}

const {
  title = "Ano vs Produtividade de Recursos",
  filterLabels = ["Milhões €/t", "Anual", "Portugal"],
  points,
  yMax = 2,
  locale = "pt-PT"
} = Astro.props;

const tickSteps = 4;
const yTicks = Array.from({ length: tickSteps + 1 }, (_, i) => yMax * (1 - i / tickSteps));

const chartHeightPx = 220;
const labelBandPx = 52;

function formatTick(n: number): string {
  return new Intl.NumberFormat(locale, {
    minimumFractionDigits: n % 1 === 0 ? 0 : 1,
    maximumFractionDigits: 1
  }).format(n);
}

function formatValueForAria(n: number): string {
  return new Intl.NumberFormat(locale, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }).format(n);
}

function barHeightPx(value: number): number {
  const ratio = Math.min(1, Math.max(0, value / yMax));
  const h = ratio * chartHeightPx;
  return Math.max(ratio > 0 ? 3 : 2, h);
}

---

<section
  class="flex w-full max-w-full flex-col gap-6 text-[var(--main-cinza-700)]"
  aria-label={title}
  data-resource-productivity-chart
  data-locale={locale}
>
  <div class="flex flex-wrap items-center gap-2">
    <h2
      class="shrink-0 font-[family-name:var(--font-secondary)] text-[length:var(--typography-font-size-body)] leading-[var(--typography-line-height-i)] tracking-[var(--typography-letter-spacing-0)] text-[var(--main-cinza-400)]"
    >
      {title}
    </h2>
    {
      filterLabels.map((label) => (
        <span
          class="rounded-full bg-[var(--main-cinza-200)] px-4 py-1 font-[family-name:var(--font-additional)] text-[length:var(--typography-font-size-extra)] leading-[var(--typography-line-height-j)] text-[var(--main-cinza-700)]"
        >
          {label}
        </span>
      ))
    }
  </div>

  <div class="relative min-w-0 overflow-x-auto pb-1">
    <div class="grid min-w-[min(100%,720px)] grid-cols-[minmax(2rem,2.25rem)_1fr] gap-x-2 sm:min-w-[840px]">
      <div
        class="pointer-events-none flex flex-col justify-between pt-0.5 text-right font-[family-name:var(--font-secondary)] text-[length:var(--typography-font-size-body)] leading-[var(--typography-line-height-i)] text-[var(--main-cinza-400)]"
        style={`height: ${chartHeightPx}px`}
      >
        {yTicks.map((t) => (
          <span class="block w-full tabular-nums">{formatTick(t)}</span>
        ))}
      </div>

      <div class="relative" style={`height: ${chartHeightPx + labelBandPx}px`}>
        <div
          class="pointer-events-none absolute inset-x-0 top-0 flex flex-col justify-between"
          style={`height: ${chartHeightPx}px`}
        >
          {yTicks.map(() => (
            <div class="h-px w-full bg-[var(--monochrome-light-400)]" />
          ))}
        </div>

        <div
          class="absolute inset-x-0 top-0 flex items-end justify-between gap-0.5 px-0.5"
          style={`height: ${chartHeightPx}px`}
          role="group"
          aria-label="Valores por ano"
        >
          {
            points.map((p) => (
              <button
                type="button"
                class="group flex min-w-[14px] max-w-[20px] flex-1 flex-col items-center justify-end focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--main-teal-400)]"
                data-bar
                data-year={p.year}
                data-value={p.value}
                aria-label={`Ano ${p.year}, ${formatValueForAria(p.value)}`}
              >
                <span
                  class="w-4 max-w-full shrink-0 rounded-full bg-[var(--main-cinza-200)] transition-colors duration-150 group-hover:bg-[var(--main-cinza-500)] group-focus-visible:bg-[var(--main-cinza-500)]"
                  style={`height: ${barHeightPx(p.value)}px`}
                />
              </button>
            ))
          }
        </div>

        <div
          class="absolute inset-x-0 flex items-start justify-between gap-0.5 px-0.5"
          style={`top: ${chartHeightPx + 12}px; height: ${labelBandPx - 12}px`}
        >
          {
            points.map((p) => (
              <div class="flex min-w-[14px] max-w-[20px] flex-1 flex-col items-center justify-start">
                <div class="flex h-12 w-full items-center justify-center overflow-visible">
                  <span class="-rotate-90 whitespace-nowrap font-[family-name:var(--font-secondary)] text-[length:var(--typography-font-size-body)] leading-[var(--typography-line-height-i)] text-[var(--main-cinza-400)]">
                    {p.year}
                  </span>
                </div>
              </div>
            ))
          }
        </div>

        <div
          class="pointer-events-none absolute z-10 hidden -translate-x-1/2 rounded-lg bg-[var(--main-teal-400)] px-3 py-2 text-center font-[family-name:var(--font-secondary)] text-sm font-medium text-white shadow-md"
          data-tooltip
          role="tooltip"
          aria-hidden="true"
        >
          <span data-tooltip-value />
          <div
            class="absolute left-1/2 top-full h-0 w-0 -translate-x-1/2 border-x-[7px] border-x-transparent border-t-[8px] border-t-[var(--main-teal-400)]"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function formatValue(v, locale) {
      return new Intl.NumberFormat(locale || "pt-PT", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(v);
    }

    function init(root) {
      var tooltip = root.querySelector("[data-tooltip]");
      var valueEl = root.querySelector("[data-tooltip-value]");
      var locale = root.getAttribute("data-locale") || "pt-PT";
      if (!tooltip || !valueEl) return;

      var hideTimer = null;

      function hide() {
        tooltip.classList.add("hidden");
        tooltip.setAttribute("aria-hidden", "true");
      }

      function show(bar) {
        var v = Number(bar.getAttribute("data-value"));
        valueEl.textContent = formatValue(v, locale);
        tooltip.classList.remove("hidden");
        tooltip.setAttribute("aria-hidden", "false");

        var rect = bar.getBoundingClientRect();
        var chartArea = bar.parentElement;
        if (!chartArea) return;
        var areaRect = chartArea.getBoundingClientRect();
        var centerX = rect.left - areaRect.left + rect.width / 2;
        var topPx = rect.top - areaRect.top - tooltip.offsetHeight - 10;
        tooltip.style.left = centerX + "px";
        tooltip.style.top = Math.max(4, topPx) + "px";
      }

      root.querySelectorAll("[data-bar]").forEach(function (bar) {
        bar.addEventListener("mouseenter", function () {
          if (hideTimer) clearTimeout(hideTimer);
          show(bar);
        });
        bar.addEventListener("focus", function () {
          if (hideTimer) clearTimeout(hideTimer);
          show(bar);
        });
        bar.addEventListener("mouseleave", function () {
          hideTimer = setTimeout(hide, 80);
        });
        bar.addEventListener("blur", function () {
          hideTimer = setTimeout(hide, 80);
        });
      });

      root.addEventListener("keydown", function (e) {
        if (e.key === "Escape") hide();
      });
    }

    document.querySelectorAll("[data-resource-productivity-chart]").forEach(init);
  })();
</script>
