---
import { menuItemHref } from "@getquick/content";
import { content } from "../../../lib/content";
import { safeHref } from "../../../lib/safe-href";
import type { WpParsedBlock } from "../../../lib/wp-blocks";
import { wpText as text } from "../normalizers";
import type { AttrsFor } from "../wp-block-attrs";
import "../../../styles/nomia-header-actions.css";

interface Props { block: WpParsedBlock }
const { block } = Astro.props;
const attrs = block.attrs as AttrsFor<"getquick/header-contact">;
const label = text(attrs.label).trim() || "Contactos";
const safeLink = safeHref(attrs.href ?? "/contactos/");
const href = safeLink ? menuItemHref(safeLink, [
  ...content().internalOrigins(Astro.site?.origin), Astro.url.origin,
]) : "";
const icon = safeHref(attrs.iconUrl);
---

{href && (
  <a class="nomia-header-action nomia-header-contact" href={href} aria-label={label}>
    {icon ? <img src={icon} alt="" width="24" height="24" /> : (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
    )}
  </a>
)}
