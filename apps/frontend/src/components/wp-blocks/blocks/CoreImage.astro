---
import { wpAlignmentClass } from "../../../lib/wp-alignment";
import { presentationHtml, presentationVariables } from "@getquick/content";
import type { WpParsedBlock } from "../../../lib/wp-blocks";

interface Props {
  block: WpParsedBlock;
}

const { block } = Astro.props;
const attrs = (block.attrs ?? {}) as Record<string, unknown>;
const url = typeof attrs.url === "string" ? attrs.url : null;
const alt = typeof attrs.alt === "string" ? attrs.alt : "";
const cls = typeof attrs.className === "string" ? attrs.className : "";
/**
 * Only the figure this component builds needs the alignment class added back.
 * The saved-markup branch below already carries WordPress's own `align*` class
 * on the inner `<figure>`, and repeating it on the wrapper would float twice.
 */
const alignment = wpAlignmentClass(attrs.align);
// Prefer the saved figure: links, picture sources, captions and dimensions are
// authored semantics. Rebuilding from attrs.url would discard them.
const saved = block.innerHTML.trim()
  ? presentationHtml("core/image", block.innerHTML, attrs.presentation, { attributes: attrs })
  : null;
const variables = saved ? undefined : presentationVariables("core/image", attrs.presentation, { attributes: attrs });
---

{
  saved ? (
    <Fragment set:html={saved} />
  ) : url ? (
    <figure class:list={["wp-block-image", "gqd-presentation", alignment, cls]} style={variables}>
      <img src={url} alt={alt} class="h-auto max-w-full" loading="lazy" decoding="async" />
    </figure>
  ) : (
    <div class:list={["wp-block-image", cls]} set:html={block.innerHTML} />
  )
}
