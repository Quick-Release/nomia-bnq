---
import { WP_PDF_EMBED_PREVIEW } from "../../../lib/wp-content-classes";
import type { WpParsedBlock } from "../../../lib/wp-blocks";
import { wpColumnWrapper, wpColumnsWrapper } from "../../../lib/wp-columns";
import { presentationVariables } from "@getquick/content";

interface Props {
  block: WpParsedBlock;
  wrapped: boolean;
}

const { block, wrapped } = Astro.props;
const wrapper =
  block.blockName === "core/column"
    ? wpColumnWrapper(block.attrs)
    : { ...wpColumnsWrapper(block.attrs), style: undefined };
const variables = presentationVariables(
  block.blockName === "core/column" ? "core/column" : "core/columns",
  block.attrs?.presentation,
);
const style = [wrapper.style, ...Object.entries(variables).map(([name, value]) => `${name}:${value}`)]
  .filter(Boolean).join(";") || undefined;
---

{wrapped ? (
  <div class:list={[...wrapper.classNames, "gqd-presentation"]} id={wrapper.id} style={style}>
    <slot />
  </div>
) : (
  <div class:list={["contents", WP_PDF_EMBED_PREVIEW]}>
    <slot />
  </div>
)}
