---
import type { WpParsedBlock } from "../../../lib/wp-blocks";
import { addDefaultPdfEmbeds } from "../../../lib/wp-pdf-embeds";
import { presentationHtml } from "@getquick/content";

interface Props {
  block: WpParsedBlock;
  wrapped?: boolean;
  openingTag?: string;
  closingTag?: string;
}

const { block, wrapped, openingTag, closingTag } = Astro.props;
const shell = wrapped ? presentationHtml(block.blockName ?? "core/list", `${openingTag ?? ""}${closingTag ?? ""}`, block.attrs?.presentation, { attributes: block.attrs ?? {} }) : "";
const end = shell.lastIndexOf("</");
---

{wrapped === undefined ? (
  <Fragment set:html={addDefaultPdfEmbeds(presentationHtml(block.blockName ?? "core/list", block.innerHTML, block.attrs?.presentation, { attributes: block.attrs ?? {} }))} />
) : wrapped ? (
  <>
    <Fragment set:html={shell.slice(0, end)} />
    <slot />
    <Fragment set:html={shell.slice(end)} />
  </>
) : (
  <slot />
)}
