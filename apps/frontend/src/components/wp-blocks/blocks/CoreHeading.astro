---
import { presentationHtml } from "@getquick/content";
import type { WpParsedBlock } from "../../../lib/wp-blocks";

interface Props {
  block: WpParsedBlock;
}

const { block } = Astro.props;
---

<Fragment set:html={presentationHtml("core/heading", block.innerHTML, block.attrs?.presentation, { attributes: block.attrs ?? {} })} />
