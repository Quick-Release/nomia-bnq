---
import type { WpParsedBlock } from "../../../lib/wp-blocks";
import { readWpButtonsLayout, wpButtonsClass } from "../../../lib/wp-buttons";

/**
 * `core/buttons`: the group's justification and orientation come from its
 * `layout` attribute, which WordPress turns into classes only at render time,
 * so the saved wrapper markup is not reused. Children arrive as the slot.
 */
interface Props {
  block: WpParsedBlock;
}

const { block } = Astro.props;
const layout = readWpButtonsLayout(block.attrs);
const id = /<div\b[^>]*\bid="([^"]+)"/i.exec(block.innerHTML ?? "")?.[1];
---

<div class:list={["wp-block-buttons my-6", wpButtonsClass(layout)]} id={id}>
  <slot />
</div>
