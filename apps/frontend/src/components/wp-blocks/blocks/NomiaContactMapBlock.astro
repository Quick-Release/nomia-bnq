---
import type { WpParsedBlock } from "../../../lib/wp-blocks";
import { contactMapPlaceholder } from "../../../lib/consent";
import { routeOf } from "@getquick/content";
import { content } from "../../../lib/content";
import { toGoogleMapsEmbedUrl } from "../../../lib/google-maps";
import { readNomiaContactMapAlignment } from "../../../lib/nomia-contact-map";
import { optionalText, wpText as text } from "../normalizers";
import type { AttrsFor } from "../wp-block-attrs";

interface Props {
  block: WpParsedBlock;
}

const { block } = Astro.props;
const attrs = block.attrs as AttrsFor<"getquick/nomia-contact-map">;
const mapUrl = optionalText(attrs.mapUrl, attrs.url) ?? "";
const blockTitle = text(attrs.title);
const title = blockTitle || "Mapa";
const embedUrl = toGoogleMapsEmbedUrl(mapUrl, blockTitle);
const align = readNomiaContactMapAlignment(attrs.align);
// Google Maps is an external_media service (CONSENT-1 CN-R13): the map loads
// from a consent placeholder, never as a live iframe in the page's HTML.
const map = embedUrl
  ? contactMapPlaceholder({
      src: embedUrl,
      title,
      language: content().routeLanguage(routeOf(Astro.url.pathname)).lang,
    })
  : "";
---

{
  embedUrl ? (
    <div class="nomia-page-gutter">
    <section
      class:list={["nomia-contact-map", align !== "none" && `nomia-contact-map--align-${align}`]}
      aria-label={title}
    >
      <Fragment set:html={map} />
    </section>
    </div>
  ) : null
}

<style>
  .nomia-contact-map {
    margin: clamp(32px, 6vw, 72px) auto;
    max-width: min(100%, 1180px);
    width: 100%;
  }

  /* The consent placeholder, and the map iframe inside it once loaded. */
  .nomia-contact-map :global(.gq-consent-embed) {
    aspect-ratio: 16 / 9;
    background: var(--color-monochrome-light-100, #f3f3f3);
    min-height: 320px;
    width: 100%;
  }

  /* Pinned to one side at a narrower width; mobile keeps the full column. */
  .nomia-contact-map--align-left,
  .nomia-contact-map--align-right {
    max-width: min(100%, 720px);
  }

  .nomia-contact-map--align-left {
    margin-left: 0;
  }

  .nomia-contact-map--align-right {
    margin-right: 0;
  }

  /*
   * Full bleed past any gutters. `overflow-x: clip` on the body (BaseLayout)
   * absorbs the scrollbar width that `100vw` does not account for.
   */
  .nomia-contact-map--align-full {
    margin-inline: calc(50% - 50vw);
    max-width: 100vw;
    width: 100vw;
  }

  .nomia-contact-map--align-full :global(.gq-consent-embed) {
    aspect-ratio: auto;
    height: clamp(420px, 60vh, 720px);
  }

  @media (max-width: 640px) {
    .nomia-contact-map :global(.gq-consent-embed) {
      aspect-ratio: 4 / 5;
      min-height: 420px;
    }
  }
</style>
