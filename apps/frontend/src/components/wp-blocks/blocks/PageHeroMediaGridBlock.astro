---
import { content } from "../../../lib/content";
import { thematicAreaStyle } from "../../../lib/thematic-area";
import { firstPartyMedia } from "../../../lib/consent";
import NomiaPageHeroMediaGrid from "../../page-heroes/NomiaPageHeroMediaGrid.astro";
import type { PageHeroMediaGridAction } from "../../page-heroes/NomiaPageHeroMediaGrid.astro";
import type { WpParsedBlock } from "../../../lib/wp-blocks";
import { optionalText, wpText as text } from "../normalizers";
import {
  normalizeTextVerticalAlign,
  PAGE_HERO_MEDIA_GRID_DEFAULTS,
} from "../../page-heroes/pageHeroMediaGridShared";
import type { AttrsFor } from "../wp-block-attrs";

interface Props {
	block: WpParsedBlock;
}

type PageHeroMediaGridAttrs = AttrsFor<"getquick/page-hero-media-grid">;

const { block } = Astro.props;
const attrs = block.attrs as PageHeroMediaGridAttrs;

function action(title: unknown, body: unknown, href: unknown): PageHeroMediaGridAction {
	return {
		title: text(title),
		text: text(body),
		href: text(href),
	};
}

const backgroundImageSrc = optionalText(attrs.backgroundImageSrc);
const backgroundImageAlt = text(attrs.backgroundImageAlt);
// Only the Site's own video plays (lib/consent.ts): one from another host
// would be a third-party request before consent. Without it the poster shows.
const videoSrc = firstPartyMedia(optionalText(attrs.videoSrc));
const videoPosterSrc = optionalText(attrs.videoPosterSrc);
const heading = text(attrs.heading) || PAGE_HERO_MEDIA_GRID_DEFAULTS.heading;
const videoTitle = text(attrs.videoTitle) || "Video";

const actions: [PageHeroMediaGridAction, PageHeroMediaGridAction] = [
	action(attrs.firstTitle, attrs.firstText, attrs.firstHref),
	action(attrs.secondTitle, attrs.secondText, attrs.secondHref),
];

// The Site's thematic identity overrides legacy card colors stored in the CMS.
const internalOrigins = [...content().internalOrigins(Astro.site?.origin), Astro.url.origin];
const thematicStyles: [string, string] = [
  thematicAreaStyle(actions[0].href, internalOrigins),
  thematicAreaStyle(actions[1].href, internalOrigins),
];
const firstBorderRadius = optionalText(attrs.firstBorderRadius) || PAGE_HERO_MEDIA_GRID_DEFAULTS.firstBorderRadius;
const secondBorderRadius = optionalText(attrs.secondBorderRadius) || PAGE_HERO_MEDIA_GRID_DEFAULTS.secondBorderRadius;

const textVerticalAlign = normalizeTextVerticalAlign(attrs.textVerticalAlign);
const videoBorderRadius = optionalText(attrs.videoBorderRadius) || PAGE_HERO_MEDIA_GRID_DEFAULTS.videoBorderRadius;
const shareHref = Object.hasOwn(attrs, "shareHref")
  ? optionalText(attrs.shareHref)
  : PAGE_HERO_MEDIA_GRID_DEFAULTS.shareHref;
const shareLabel = Object.hasOwn(attrs, "shareLabel")
  ? text(attrs.shareLabel)
  : PAGE_HERO_MEDIA_GRID_DEFAULTS.shareLabel;

const canRender = Boolean(backgroundImageSrc || actions.some((item) => item.title) || videoSrc);
---

{
	canRender ? (
		<NomiaPageHeroMediaGrid
			backgroundImageSrc={backgroundImageSrc}
			backgroundImageAlt={backgroundImageAlt}
			heading={heading}
			actions={actions}
			videoSrc={videoSrc}
			videoPosterSrc={videoPosterSrc}
			videoTitle={videoTitle}
			textVerticalAlign={textVerticalAlign}
			shareHref={shareHref}
			shareLabel={shareLabel}
			thematicStyles={thematicStyles}
			firstBorderRadius={firstBorderRadius}
			secondBorderRadius={secondBorderRadius}
			videoBorderRadius={videoBorderRadius}
		/>
	) : null
}
