---
import GraficoDonutSection from "../../charts/pie/GraficoDonutSection.astro";
import { PAGE_FRAME } from "../../../lib/site-gutters";
import type { WpParsedBlock } from "../../../lib/wp-blocks";
import { normalizeDonutSlices } from "../donut-slice";

interface Props {
  block: WpParsedBlock;
}
const { block } = Astro.props;
const slices = normalizeDonutSlices(block);
---

{
  slices.length > 0 ? (
    <div class={`${PAGE_FRAME} py-16 md:py-20`}>
      <GraficoDonutSection slices={slices} />
    </div>
  ) : null
}
