---
/** Generated by `pnpm structured-blocks:sync`. Do not edit directly. */
import type { WpParsedBlock } from "../../lib/wp-blocks";
import { resolveWpUnsupportedFallback, type WpUnsupportedFallbackMode } from "../../lib/wp-block-fallback";
import type { WpPagePayload } from "../../lib/wp-page-payload";
import { withSafeLinks } from "../../lib/safe-href";
import { WP_CUSTOM_BLOCK_LINK_KEYS } from "./custom-block-contracts";
import PageHeroStaticBlock from "./blocks/PageHeroStaticBlock.astro";
import PageHeroMediaGridBlock from "./blocks/PageHeroMediaGridBlock.astro";
import PageHeroSliderBlock from "./blocks/PageHeroSliderBlock.astro";
import TitleWithLabelBlock from "./blocks/TitleWithLabelBlock.astro";
import PodcastListBlock from "./blocks/PodcastListBlock.astro";
import PlataformasGridBlock from "./blocks/PlataformasGridBlock.astro";
import MapListExplorerBlock from "./blocks/MapListExplorerBlock.astro";
import BarometroResultsBlock from "./blocks/BarometroResultsBlock.astro";
import TwoColumnsTextImageBlock from "./blocks/TwoColumnsTextImageBlock.astro";
import ImageZoomBlock from "./blocks/ImageZoomBlock.astro";
import HomeIntro from "./blocks/HomeIntro.astro";
import BioeconomiaSustentavelDualCardsBlock from "./blocks/BioeconomiaSustentavelDualCardsBlock.astro";
import BioeconomiaPhasesBandBlock from "./blocks/BioeconomiaPhasesBandBlock.astro";
import BioeconomiaPabsContentSliderBlock from "./blocks/BioeconomiaPabsContentSliderBlock.astro";
import HorizontalScrollWithContentBlock from "./blocks/HorizontalScrollWithContentBlock.astro";
import EconomiaCircularOverviewSliderBlock from "./blocks/EconomiaCircularOverviewSliderBlock.astro";
import EconomiaCircularPaec2030Block from "./blocks/EconomiaCircularPaec2030Block.astro";
import EconomiaCircularMacroMesoMicroBlock from "./blocks/EconomiaCircularMacroMesoMicroBlock.astro";
import EconomiaCircularIndicadoresSpotlightBlock from "./blocks/EconomiaCircularIndicadoresSpotlightBlock.astro";
import EconomiaCircularRecursosBlock from "./blocks/EconomiaCircularRecursosBlock.astro";
import IndicadoresBlock from "./blocks/IndicadoresBlock.astro";
import OportunidadesBlock from "./blocks/OportunidadesBlock.astro";
import MultimediaBlock from "./blocks/MultimediaBlock.astro";
import BibliotecaBlock from "./blocks/BibliotecaBlock.astro";
import EventsGridBlock from "./blocks/EventsGridBlock.astro";
import EventCardCompactBlock from "./blocks/EventCardCompactBlock.astro";
import PieChartDonutBlock from "./blocks/PieChartDonutBlock.astro";
import GraficoDonutBlock from "./blocks/GraficoDonutBlock.astro";
import EnergyConsumptionGraphBlock from "./blocks/EnergyConsumptionGraphBlock.astro";
import SustainableConsumptionBarsGraphBlock from "./blocks/SustainableConsumptionBarsGraphBlock.astro";
import UrbanWasteGeoGraphBlock from "./blocks/UrbanWasteGeoGraphBlock.astro";
import ResourceProductivityBarsGraphBlock from "./blocks/ResourceProductivityBarsGraphBlock.astro";
import ResourceProductivityGraphBlock from "./blocks/ResourceProductivityGraphBlock.astro";
import NomiaContactMapBlock from "./blocks/NomiaContactMapBlock.astro";
import SectionBlock from "./blocks/SectionBlock.astro";
import ContactDetailsCardBlock from "./blocks/ContactDetailsCardBlock.astro";
import HeaderNavigationBlock from "./blocks/HeaderNavigationBlock.astro";

/** children carries nested blocks to container renderers; leaf renderers ignore it. */
type BlockRenderer = (props: {
  block: WpParsedBlock;
  pageFeaturedImage?: WpPagePayload["featuredImage"];
  children?: unknown;
}) => unknown;

const RENDERERS: Record<string, BlockRenderer> = {
  "getquick/page-hero-static": PageHeroStaticBlock,
  "getquick/page-hero-media-grid": PageHeroMediaGridBlock,
  "getquick/page-hero-slider": PageHeroSliderBlock,
  "getquick/title-with-label": TitleWithLabelBlock,
  "getquick/content-list": PodcastListBlock,
  "getquick/content-grid-filters": PlataformasGridBlock,
  "getquick/map-list": MapListExplorerBlock,
  "getquick/cta-results": BarometroResultsBlock,
  "getquick/two-columns-text-image": TwoColumnsTextImageBlock,
  "getquick/image-zoom": ImageZoomBlock,
  "getquick/home-intro": HomeIntro,
  "getquick/sustainable-bioeconomy-dual-cards": BioeconomiaSustentavelDualCardsBlock,
  "getquick/bioeconomy-phases-band": BioeconomiaPhasesBandBlock,
  "getquick/pabs-content-slider": BioeconomiaPabsContentSliderBlock,
  "getquick/horizontal-scroll-with-content": HorizontalScrollWithContentBlock,
  "getquick/circular-economy-overview": HorizontalScrollWithContentBlock,
  "getquick/circular-economy-overview-slider": EconomiaCircularOverviewSliderBlock,
  "getquick/paec-2030": EconomiaCircularPaec2030Block,
  "getquick/macro-meso-micro": EconomiaCircularMacroMesoMicroBlock,
  "getquick/circular-economy-indicators-spotlight": EconomiaCircularIndicadoresSpotlightBlock,
  "getquick/circular-economy-resources": EconomiaCircularRecursosBlock,
  "getquick/indicators-grid": IndicadoresBlock,
  "getquick/opportunities-grid": OportunidadesBlock,
  "getquick/multimedia-grid": MultimediaBlock,
  "getquick/library-grid": BibliotecaBlock,
  "getquick/events-grid": EventsGridBlock,
  "getquick/event-card-compact": EventCardCompactBlock,
  "getquick/pie-chart-donut": PieChartDonutBlock,
  "getquick/grafico-donut": GraficoDonutBlock,
  "getquick/energy-consumption-chart": EnergyConsumptionGraphBlock,
  "getquick/sustainable-consumption-bars": SustainableConsumptionBarsGraphBlock,
  "getquick/urban-waste-geo-chart": UrbanWasteGeoGraphBlock,
  "getquick/resource-productivity-bars": ResourceProductivityBarsGraphBlock,
  "getquick/resource-productivity-chart": ResourceProductivityGraphBlock,
  "getquick/nomia-contact-map": NomiaContactMapBlock,
  "getquick/section": SectionBlock,
  "getquick/contact-details-card": ContactDetailsCardBlock,
  "getquick/header-navigation": HeaderNavigationBlock,
};

interface Props {
  block: WpParsedBlock;
  pageFeaturedImage?: WpPagePayload["featuredImage"];
  unsupportedFallback?: WpUnsupportedFallbackMode;
  hasFallbackContent?: boolean;
}

const {
  block,
  pageFeaturedImage = null,
  unsupportedFallback = "saved-content",
  hasFallbackContent = false,
} = Astro.props;
const Renderer = RENDERERS[block.blockName ?? ""];
// WordPress runs esc_url() over links it renders; Astro renders these, so
// unsafe link schemes are dropped here, once, for every block.
const renderedBlock = withSafeLinks(block, WP_CUSTOM_BLOCK_LINK_KEYS[block.blockName ?? ""]);
const resolvedFallback = resolveWpUnsupportedFallback(unsupportedFallback, hasFallbackContent);
const unsupportedBlockName = block.blockName ?? "unknown WordPress block";
---

{Renderer ? (
  <Renderer block={renderedBlock} pageFeaturedImage={pageFeaturedImage}>
    <slot />
  </Renderer>
) : resolvedFallback === "diagnostic" ? (
  <aside
    class="my-4 border border-amber-300 bg-amber-50 p-4 text-amber-950"
    data-nomia-unsupported-block={unsupportedBlockName}
    data-nomia-unsupported-fallback={resolvedFallback}
    role="status"
  >
    <p class="font-semibold">Unsupported WordPress block</p>
    <code class="mt-1 block text-sm">{unsupportedBlockName}</code>
    {hasFallbackContent ? (
      <div class="contents">
        <slot />
      </div>
    ) : (
      <p class="mt-2 text-sm">
        No saved markup or nested content is available for this block.
      </p>
    )}
  </aside>
) : (
  <div
    class="contents"
    data-nomia-unsupported-block={unsupportedBlockName}
    data-nomia-unsupported-fallback={resolvedFallback}
  >
    <slot />
  </div>
)}
