---
/**
 * Two columns text/image — texto + uma imagem (Figma 40017244:12833).
 * Defaults carregados de `./defaults` para separar conteúdo e estrutura.
 * Bridge WP -> FE: `src/components/wp-blocks/blocks/TwoColumnsTextImageBlock.astro`.
 * Admin Gutenberg contract (first-party CMS plugin):
 * `apps/cms/web/app/plugins/nomia-blocks/src/Contracts.php` in block `getquick/editorial-split`.
 * https://www.figma.com/design/gWqEtVBfoWbYMHQh1rW6s3/Nomia-%E2%80%94-Website--2-?node-id=40017244-12833
 */
import { TWO_COLUMNS_TEXT_IMAGE_DEFAULTS } from "./defaults";
import NomiaEyebrowIconLabel from "../../ui/NomiaEyebrowIconLabel.astro";
import NomiaOutlinePillButton from "../../ui/NomiaOutlinePillButton.astro";

const {
	eyebrowLabel = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.eyebrowLabel,
	accent = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.accent,
	heading = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.heading,
	body = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.body,
	ctaHref = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.ctaHref,
	ctaLabel = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.ctaLabel,
	primarySrc = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.primarySrc,
	primaryAlt = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.primaryAlt,
	mediaPosition = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.mediaPosition,
	hideCta = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.hideCta,
	hideTaxonomy = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.hideTaxonomy,
	headingId = TWO_COLUMNS_TEXT_IMAGE_DEFAULTS.headingId,
} = Astro.props as {
	eyebrowLabel?: string;
	accent?: "ciano" | "botnico";
	heading?: string;
	body?: string;
	ctaHref?: string;
	ctaLabel?: string;
	primarySrc?: string;
	primaryAlt?: string;
	mediaPosition?: "left" | "right";
	hideCta?: boolean;
	hideTaxonomy?: boolean;
	headingId?: string;
};

const mediaPositionClass = mediaPosition === "left" ? "lg:flex-row-reverse" : "lg:flex-row";
const mediaAlignClass = mediaPosition === "left" ? "lg:mr-auto lg:ml-0" : "lg:ml-auto lg:mr-0";
---

<section
	class="bg-neutral-bw-white w-full overflow-x-hidden"
	aria-labelledby={headingId}
	data-nomia-header-surface="light"
>
	<div
		class={`mx-auto flex w-full max-w-[1920px] flex-col gap-12 px-4 py-16 md:gap-14 md:px-16 md:py-20 ${mediaPositionClass} lg:items-center lg:justify-between lg:gap-16 lg:py-28 xl:gap-24 2xl:gap-[7.75rem]`}
	>
		<header class="flex w-full max-w-[55rem] flex-col gap-10">
			{
				!hideTaxonomy && (
					<NomiaEyebrowIconLabel label={eyebrowLabel} accent={accent} />
				)
			}

			<div class="flex w-full flex-col gap-4 text-main-cinza-700">
				<h2
					id={headingId}
					class="text-h4 font-primary font-semibold leading-[var(--typography-line-height-f)] tracking-[var(--tracking-typography-0)]"
				>
					{heading}
				</h2>
				<p
					class="text-subtitle font-primary font-normal leading-[var(--typography-line-height-g)] tracking-[var(--tracking-typography-0)]"
				>
					{body}
				</p>
			</div>

			{
				!hideCta && (
					<NomiaOutlinePillButton href={ctaHref} label={ctaLabel} class="w-fit" />
				)
			}
		</header>

		<figure
			class="relative mx-auto w-full max-w-[42rem] shrink-0 pt-4 pb-2 lg:mx-0 lg:max-w-none lg:flex-1 lg:self-stretch lg:pt-0 lg:pb-0"
		>
			<div class={`relative mx-auto aspect-[664/376] w-full max-w-[41.5rem] ${mediaAlignClass}`}>
				<div
					class="border-main-cinza-700 relative left-0 top-0 w-[min(100%,41.5rem)] overflow-hidden rounded-2xl border border-solid shadow-sm"
				>
					<div class="aspect-[664/376] w-full">
						<img
							src={primarySrc}
							alt={primaryAlt}
							class="size-full object-cover"
							width="885"
							height="1328"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>
		</figure>
	</div>
</section>
