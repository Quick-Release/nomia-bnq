---
/**
 * A header or footer pattern GQ Design's Header & Footer selects, as the
 * chrome serves it (`chrome.header` / `chrome.footer`). The runtime renders
 * GQ Design's own blocks to HTML; Nomia's blocks (`getquick/*`, such as the
 * header navigation) have no saved HTML and render through the same Astro
 * renderers as in content, wherever they sit in the pattern: the runtime
 * leaves a marker in their place, and each marker becomes the Astro block.
 */
import type { DesignBlock, DesignPattern, SiteLanguage } from "@getquick/content";
import { content } from "../lib/content";
import type { WpParsedBlock } from "../lib/wp-blocks";
import WpCustomBlock from "./wp-blocks/WpCustomBlock.astro";

interface Props {
  pattern: DesignPattern;
  language: SiteLanguage;
}

const { pattern, language } = Astro.props;
const runtime = content();

const nomiaNames = new Set<string>();
const collect = (blocks: DesignBlock[]) => {
  for (const block of blocks) {
    if (block.name.startsWith("getquick/")) nomiaNames.add(block.name);
    collect(block.children);
  }
};
collect(pattern.blocks);

// The nonce keeps saved HTML from passing for a marker.
const nonce = Math.random().toString(36).slice(2, 10);
const nomiaBlocks: DesignBlock[] = [];
const marker = (block: DesignBlock) => `<!--nomia-block:${nonce}:${nomiaBlocks.push(block) - 1}-->`;
const html = runtime.renderDesignPattern(pattern.blocks, {
  siteOrigin: Astro.site?.origin,
  home: language.home,
  blocks: Object.fromEntries([...nomiaNames].map((name) => [name, marker])),
  onUnrendered: (block: DesignBlock) => console.warn(`No renderer for ${block.name} in "${pattern.title}"`),
});
// Odd parts are the marked blocks' indexes, even parts the HTML between them.
const parts = html.split(new RegExp(`<!--nomia-block:${nonce}:(\\d+)-->`));

// GQ Design's attributes are the block's saved ones (menu-backed blocks with
// their menu's items), as the content's renderers read them from `attrs`.
const parsed = (block: DesignBlock): WpParsedBlock => ({
  blockName: block.name,
  attrs: block.attributes,
  innerBlocks: [],
  innerHTML: block.content ?? "",
  innerContent: block.content === null ? [] : [block.content],
});
---

{
  parts.map((part, index) =>
    index % 2 ? <WpCustomBlock block={parsed(nomiaBlocks[Number(part)])} /> : <Fragment set:html={part} />,
  )
}
