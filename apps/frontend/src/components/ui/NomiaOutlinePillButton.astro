---
interface Props {
	href: string;
	label: string;
	class?: string;
	focusOffsetClass?: string;
	nodeId?: string;
}

const {
	href,
	label,
	class: className = "",
	focusOffsetClass = "focus-visible:ring-offset-neutral-bw-white",
	nodeId,
} = Astro.props as Props;
---

<a
	href={href}
	data-node-id={nodeId}
	class={`text-notes text-main-cinza-700 font-primary border-main-cinza-700 hover:bg-main-cinza-700 focus-visible:ring-main-teal-400 inline-flex items-center justify-center gap-2 rounded-[40px] border border-solid px-4 py-2 font-medium tracking-[var(--tracking-typography-0)] transition-colors hover:text-neutral-bw-white focus-visible:ring-2 focus-visible:ring-offset-2 ${focusOffsetClass} focus-visible:outline-none ${className}`.trim()}
>
	{label}
</a>
