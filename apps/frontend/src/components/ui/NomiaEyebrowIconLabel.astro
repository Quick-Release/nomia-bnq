---
interface Props {
	label: string;
	accent?: "ciano" | "botnico" | "cinza";
	uppercase?: boolean;
	class?: string;
	/** Inline typography overrides for the label text (never for the icon). */
	labelStyle?: string | undefined;
	wrapperNodeId?: string;
	iconNodeId?: string;
	labelNodeId?: string;
}

const {
	label,
	accent = "ciano",
	uppercase = true,
	class: className = "",
	labelStyle,
	wrapperNodeId,
	iconNodeId,
	labelNodeId,
} = Astro.props as Props;
const accentClass = accent === "botnico"
	? "text-main-botnico-400"
	: accent === "cinza"
		? "text-main-cinza-400"
		: "text-main-ciano-400";
const casingClass = uppercase ? "uppercase" : "";
---

<div class={`flex items-center gap-1 ${className}`.trim()} data-node-id={wrapperNodeId}>
	<span class={`${accentClass} inline-flex size-6 shrink-0`} aria-hidden="true" data-node-id={iconNodeId}>
		<svg class="size-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path
				d="M12 4v16M4 12h16M6.34 6.34l11.32 11.32M17.66 6.34L6.34 17.66"
				stroke="currentColor"
				stroke-width="1.35"
				stroke-linecap="round"></path>
		</svg>
	</span>
	<p
		class={`text-body ${accentClass} ${casingClass} font-primary font-medium tracking-[var(--tracking-typography-0)]`.trim()}
		style={labelStyle}
		data-node-id={labelNodeId}
	>
		{label}
	</p>
</div>
