---
import { blockPresetStyles, designPostContext, formatDate, responseStatus, routeOf } from "@getquick/content";
import NomiaContentListing from "../components/content-lists/listing/NomiaContentListing.astro";
import Home from "../components/Home.astro";
import NomiaBlocks from "../components/NomiaBlocks.astro";
import Layout from "../layouts/Layout.astro";
import { content } from "../lib/content";
import { copyFor } from "../lib/copy";
import { pageForms } from "../lib/forms";
import { categoryHeroBlock, categoryHeroPage } from "../lib/category-hero";
import { isLibraryDocument } from "../lib/library-document";
import { nomiaPage } from "../lib/nomia-content";
import { embedPdfFileBlocks } from "../lib/wp-pdf-embeds";

const runtime = content();
const route = routeOf(Astro.url.pathname);
const language = runtime.routeLanguage(route);
const copy = copyFor(language, runtime.multilingual);

// Another language's home (/en/) is served as a home, as index.astro serves
// the default language's.
const home = runtime.isLanguageHome(route)
  ? await runtime.publishedHome(Astro.site?.origin, language)
  : null;
const placeholder = home?.kind === "unavailable" && import.meta.env.DEV;

// Served from the publication store, last-known-good and without an age
// limit. Only an entry the store has never held is looked up in the CMS.
const delivery = home ?? (await runtime.publishedEntry(Astro.url.pathname, Astro.site?.origin));
// An entry published at another URI now: its old route redirects there,
// uncached, since the store's answer can change with the next refresh.
if (delivery.kind === "moved") {
  return new Response(null, {
    status: 301,
    headers: { Location: encodeURI(delivery.uri), "Cache-Control": "no-store" },
  });
}
// Only a confirmed missing entry is a 404; a CMS or store failure is a 503.
Astro.response.status = placeholder ? 200 : responseStatus(delivery);
// Every visit is answered from the store, so a cache may keep a page but must
// ask again before reusing it: a withdrawn entry is never presented from one.
Astro.response.headers.set("Cache-Control", "no-cache");
const found = !home && delivery.kind === "found" ? delivery.content : null;
const entry = found && "entry" in found ? found.entry : null;
const chrome =
  delivery.kind === "found" ? delivery.content.chrome : delivery.kind === "missing" ? delivery.chrome : null;
const alternates = found?.alternates ?? [];
// An Indicador's chart is its extension too, but its page is WordPress's.
const nomia = nomiaPage(entry?.extension);
const gallery = entry?.extension && "kind" in entry.extension && entry.extension.kind === "gallery" ? entry.extension : null;
const { vars, colorRules } = blockPresetStyles(entry?.spacingSizes ?? [], entry?.colors ?? []);
const isPost = Boolean(entry?.date);
// A Biblioteca document shows its PDF in the page, and no date.
const libraryDocument = isLibraryDocument(entry?.collection);
// An Oportunidade in a category with its own page (Formação) is shown under
// that page's hero, with its own title and without its date. The hero is read
// from the store, so it follows the page as editors change it: a hero without
// its own image shows that page's featured image, as it does on the page.
const heroPage = entry && !nomia && !gallery && !entry.hasVideoHero ? categoryHeroPage(entry.collection) : null;
const heroDelivery = heroPage ? await runtime.publishedEntry(heroPage, Astro.site?.origin) : null;
const heroEntry =
  heroDelivery?.kind === "found" && "entry" in heroDelivery.content ? heroDelivery.content.entry : null;
const heroPageNomia = nomiaPage(heroEntry?.extension);
const categoryHero =
  entry && heroPageNomia ? categoryHeroBlock(heroPageNomia.blocks, entry.title) : null;
// Its gravityforms/form blocks' descriptors, and the outcome of a post the
// visitor was just sent back from, which is shown once.
const { forms, setCookies } = pageForms({
  descriptors: entry?.forms,
  url: Astro.url,
  cookie: Astro.request.headers.get("Cookie"),
  language: language.lang,
  legal: chrome?.legal ?? null,
});
for (const cookie of setCookies) Astro.response.headers.append("Set-Cookie", cookie);
// That outcome holds what the visitor typed: no cache may keep it.
if (setCookies.length) Astro.response.headers.set("Cache-Control", "private, no-store");
const title =
  entry?.title || (delivery.kind === "unavailable" ? copy.pageUnavailable.title : copy.pageMissing.title);
---

{home ? (
  <Home home={home} language={language} placeholder={placeholder} />
) : (
<Layout post={entry ? designPostContext(entry) ?? undefined : undefined} theme={entry?.theme} title={title} chrome={chrome} language={language} alternates={alternates}>
  {entry ? (
    gallery ? (
      <main>
        <h1 class="font-primary px-6 pt-12 text-3xl">{entry.title}</h1>
        <NomiaContentListing display="thumbnail-grid" empty="none" lightbox rows={gallery.images.map((image) => ({ href: image.url, title: entry.title, imageSrc: image.url, imageAlt: image.alt || entry.title }))} />
      </main>
    ) : nomia ? (
      <NomiaBlocks nomia={nomia} design={entry} featuredImage={entry.featuredImage} language={language} forms={forms} />
    ) : entry.hasVideoHero ? (
      <>
        <style is:global set:html={colorRules} />
        <main class="prose-wp prose-wp--video-hero" style={vars} set:html={entry.content}></main>
      </>
    ) : categoryHero && heroPageNomia ? (
      <NomiaBlocks
        nomia={{ blocks: [categoryHero], pageBackgroundColor: null, thematicColors: heroPageNomia.thematicColors }}
        design={entry}
        featuredImage={heroEntry?.featuredImage ?? null}
        language={language}
      >
        {entry.content.trim() && (
          <div class="category-hero-body">
            <style is:global set:html={colorRules} />
            <div class="prose-wp" style={vars} set:html={embedPdfFileBlocks(entry.content)}></div>
          </div>
        )}
      </NomiaBlocks>
    ) : (
      <main>
        <h1>{entry.title}</h1>
        {isPost && !heroPage && !libraryDocument && <time datetime={entry.date}>{formatDate(entry.date, runtime.multilingual ? language.lang : "en")}</time>}
        {entry.featuredImage && (
          <img class="featured-image" src={entry.featuredImage.sourceUrl} alt={entry.featuredImage.altText || ""} />
        )}
        <style is:global set:html={colorRules} />
        <div class="prose-wp" style={vars} set:html={libraryDocument ? embedPdfFileBlocks(entry.content) : entry.content}></div>
      </main>
    )
  ) : delivery.kind === "missing" ? (
    <main class="empty-state">
      <h1>{copy.pageMissing.heading}</h1>
      <p>{copy.pageMissing.text}</p>
      <a href={language.home}>{copy.backHome}</a>
    </main>
  ) : (
    <main class="empty-state">
      <h1>{copy.pageUnavailable.heading}</h1>
      <p>{copy.pageUnavailable.text}</p>
      <a href={language.home}>{copy.backHome}</a>
    </main>
  )}
</Layout>
)}
