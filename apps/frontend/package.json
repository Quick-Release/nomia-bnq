{
  "name": "@nomia-bnq/frontend",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check",
    "check": "pnpm run structured-blocks:check && astro check",
    "preview": "astro preview",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vp test --passWithNoTests && pnpm run test:blocks",
    "structured-blocks:sync": "node --experimental-strip-types ./scripts/sync-wp-plugin-contracts.mjs",
    "structured-blocks:check": "node --experimental-strip-types ./scripts/sync-wp-plugin-contracts.mjs --check",
    "test:container": "node --test tests/browser/container-sizing.test.mjs",
    "test:presentation": "node --test tests/browser/*.test.mjs",
    "test:blocks": "node --experimental-strip-types --test tests/*.test.mjs",
    "consent:acceptance": "node scripts/consent-acceptance/run.mjs",
    "consent:captures": "node scripts/consent-acceptance/deployed.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@getquick/content": "0.4.0",
    "@wordpress/block-serialization-default-parser": "^5.57.0",
    "astro": "^7.2.9",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@astrojs/check": "^0.9.10",
    "@effect/platform-node": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "catalog:",
    "jsdom": "29.1.1",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plus": "^0.3.0"
  },
  "packageManager": "pnpm@12.6.0"
}
