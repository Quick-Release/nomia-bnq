{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/circular-economy-overview",
	"title": "Obsoleto: visão geral da economia circular",
	"category": "getquick-design",
	"icon": "warning",
	"description": "Bloco antigo mantido para conteúdos já publicados. Use Scroll horizontal com conteúdo.",
	"textdomain": "gq-bioeconomia",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "circular-economy-overview"
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"headingLine1": {
			"type": "string",
			"default": ""
		},
		"headingLine2": {
			"type": "string",
			"default": ""
		},
		"pills": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"label"
				],
				"properties": {
					"label": {
						"type": "string",
						"default": ""
					},
					"href": {
						"type": "string",
						"default": ""
					}
				}
			}
		},
		"verTodosHref": {
			"type": "string",
			"default": ""
		},
		"verTodosLabel": {
			"type": "string",
			"default": ""
		},
		"slides": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"caption",
					"imageSrc",
					"href"
				],
				"properties": {
					"id": {
						"type": "string",
						"default": ""
					},
					"caption": {
						"type": "string",
						"default": ""
					},
					"imageId": {
						"type": "number"
					},
					"imageSrc": {
						"type": "string",
						"default": ""
					},
					"imageAlt": {
						"type": "string",
						"default": ""
					},
					"href": {
						"type": "string",
						"default": ""
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": false
	},
	"example": {
		"attributes": {
			"eyebrow": "Visão geral",
			"headingLine1": "A Economia Circular promove um modelo económico reorganizado,",
			"headingLine2": "através da coordenação dos sistemas de produção e consumo em circuitos fechados.",
			"pills": [
				{
					"label": "Princípios",
					"href": "#principios"
				}
			],
			"verTodosHref": "/biblioteca/",
			"verTodosLabel": "Ver todos",
			"slides": [
				{
					"id": "concecao",
					"caption": "Conceção/design",
					"imageSrc": "/images/economia-circular/overview-slider/concecao.jpg",
					"imageAlt": "Espaço interior com vegetação",
					"href": "/economia-circular/concecao-design/"
				},
				{
					"id": "producao",
					"caption": "Produção",
					"imageSrc": "/images/economia-circular/overview-slider/producao.jpg",
					"imageAlt": "Antena parabólica em campo aberto",
					"href": "/economia-circular/producao/"
				}
			]
		}
	},
	"editorStyle": "gq-bioeconomia-editor"
}
