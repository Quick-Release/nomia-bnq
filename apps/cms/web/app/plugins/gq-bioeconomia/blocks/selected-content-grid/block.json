{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/selected-content-grid",
	"title": "Grelha de destaques",
	"category": "getquick-design",
	"icon": "screenoptions",
	"description": "Um destaque principal e quatro conteúdos selecionados.",
	"textdomain": "gq-bioeconomia",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "selected-content-grid"
		},
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"postId": {
						"type": "number"
					},
					"postType": {
						"type": "string",
						"default": ""
					},
					"uri": {
						"type": "string",
						"default": ""
					},
					"title": {
						"type": "string",
						"default": ""
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"items": []
		}
	},
	"editorStyle": "gq-bioeconomia-editor"
}
