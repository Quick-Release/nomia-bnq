{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/pie-chart-donut",
	"title": "Gráfico circular donut",
	"category": "getquick-design",
	"icon": "chart-pie",
	"description": "Gráfico donut com título, descrição, resumo e legenda, por exemplo para percentagens de reciclagem.",
	"textdomain": "gq-bioeconomia",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "pie-chart-donut"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"summary": {
			"type": "string",
			"default": ""
		},
		"slices": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"type",
					"label",
					"value"
				],
				"properties": {
					"type": {
						"type": "string",
						"default": ""
					},
					"label": {
						"type": "string",
						"default": ""
					},
					"value": {
						"type": "number"
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"title": "Reciclagem de resíduos",
			"description": "Compare a percentagem de resíduos reciclados por material.",
			"summary": "Os valores apresentados são dados de demonstração do gráfico.",
			"slices": [
				{
					"type": "vidro",
					"label": "Vidro",
					"value": 30
				},
				{
					"type": "metal",
					"label": "Metal",
					"value": 25
				},
				{
					"type": "papel",
					"label": "Papel",
					"value": 28
				},
				{
					"type": "plastico",
					"label": "Plástico",
					"value": 17
				}
			]
		}
	},
	"editorStyle": "gq-bioeconomia-editor"
}
