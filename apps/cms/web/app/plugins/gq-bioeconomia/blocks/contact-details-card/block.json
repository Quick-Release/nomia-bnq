{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/contact-details-card",
	"title": "Cartão de contacto",
	"category": "getquick-design",
	"icon": "id",
	"description": "Cartão com ícone, título, detalhes de contacto e botão opcional.",
	"keywords": [
		"contacto",
		"morada",
		"telefone",
		"email",
		"cartão"
	],
	"textdomain": "gq-bioeconomia",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "contact-details-card"
		},
		"iconId": {
			"type": "number"
		},
		"iconUrl": {
			"type": "string",
			"default": ""
		},
		"iconAlt": {
			"type": "string",
			"default": ""
		},
		"hideIcon": {
			"type": "boolean",
			"default": false
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"details": {
			"type": "string",
			"default": ""
		},
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"buttonHref": {
			"type": "string",
			"default": ""
		},
		"hideButton": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"iconUrl": "/images/contact-details-card/adults.svg",
			"title": "Morada",
			"details": "Serviços Centrais Rua da Murgueira, 9<br>Zambujal - Alfragide<br>2610-124 Amadora",
			"buttonLabel": "Direções",
			"buttonHref": "https://www.google.com/maps/search/?api=1&query=Rua%20da%20Murgueira%209%20Amadora"
		}
	},
	"editorStyle": [
		"gq-bioeconomia-editor",
		"file:./editor.css"
	]
}
