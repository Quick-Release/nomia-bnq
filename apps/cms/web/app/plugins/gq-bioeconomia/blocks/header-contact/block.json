{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/header-contact",
	"title": "Contacto do cabeçalho",
	"category": "getquick-design",
	"icon": "phone",
	"description": "Ícone de telefone com ligação à página de contactos ou a um número de telefone.",
	"keywords": [
		"nomia",
		"contacto",
		"telefone",
		"phone",
		"header"
	],
	"textdomain": "gq-bioeconomia",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "header-contact"
		},
		"label": {
			"type": "string",
			"default": "Contactos"
		},
		"href": {
			"type": "string",
			"default": "/contactos/"
		},
		"iconId": {
			"type": "number"
		},
		"iconUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"label": "Contactos",
			"href": "/contactos/"
		}
	},
	"editorStyle": "gq-bioeconomia-editor"
}
