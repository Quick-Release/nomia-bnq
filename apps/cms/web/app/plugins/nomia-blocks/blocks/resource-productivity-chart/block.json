{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/resource-productivity-chart",
	"title": "Gráfico de produtividade dos recursos",
	"category": "getquick-design",
	"icon": "chart-area",
	"description": "Gráfico de barras simples da produtividade dos recursos por ano, com título e etiquetas de filtro.",
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "resource-productivity-chart"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"filterLabels": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string",
				"default": ""
			}
		},
		"points": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"year",
					"value"
				],
				"properties": {
					"year": {
						"type": "number"
					},
					"value": {
						"type": "number"
					}
				}
			}
		},
		"yMax": {
			"type": "number"
		},
		"locale": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"title": "Produtividade dos recursos",
			"filterLabels": [
				"Portugal",
				"União Europeia"
			],
			"locale": "pt-PT",
			"points": [
				{
					"year": 2020,
					"value": 1.1
				},
				{
					"year": 2021,
					"value": 1.25
				},
				{
					"year": 2022,
					"value": 1.38
				},
				{
					"year": 2023,
					"value": 1.41
				}
			]
		}
	},
	"editorStyle": "getquick-nomia-blocks-editor"
}
