{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/content-listing",
	"title": "Listagem de conteúdos",
	"category": "getquick-design",
	"icon": "list-view",
	"description": "Lista os conteúdos publicados de um tipo, como os documentos da Biblioteca ou os eventos, com paginação.",
	"keywords": [
		"arquivo",
		"listagem",
		"archive",
		"listing",
		"biblioteca",
		"eventos"
	],
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "content-listing"
		},
		"collection": {
			"type": "string",
			"default": "biblioteca",
			"enum": [
				"biblioteca",
				"eventos",
				"oportunidades",
				"recursos_educativos",
				"glossario",
				"indicadores",
				"infografias",
				"videos",
				"podcasts",
				"ferramentas",
				"plataformas",
				"bases_de_dados"
			]
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"term": {
			"type": "string",
			"default": ""
		},
		"display": {
			"type": "string",
			"default": "list",
			"enum": [
				"list",
				"thumbnail-grid",
				"titled-thumbnail-grid"
			]
		},
		"perPage": {
			"type": "number",
			"default": 12
		},
		"showPagination": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"collection": "biblioteca",
			"display": "list",
			"perPage": 12,
			"showPagination": true
		}
	},
	"editorStyle": "getquick-nomia-blocks-editor"
}
