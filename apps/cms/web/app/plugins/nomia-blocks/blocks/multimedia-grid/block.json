{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/multimedia-grid",
	"title": "Grelha multimédia",
	"category": "getquick-nomia",
	"icon": "admin-media",
	"description": "Grelha de ligações para conteúdos multimédia e ferramentas, com cabeçalho, texto e etiquetas.",
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "multimedia-grid"
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"cards": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"title",
					"tag",
					"href"
				],
				"properties": {
					"title": {
						"type": "string",
						"default": ""
					},
					"tag": {
						"type": "string",
						"default": ""
					},
					"href": {
						"type": "string",
						"default": ""
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"eyebrow": "NOMIA",
			"heading": "Multimédia e ferramentas",
			"body": "Explore conteúdos e recursos para conhecer projetos, iniciativas e dados.",
			"cards": [
				{
					"title": "Infografias",
					"tag": "Multimédia",
					"href": "/infografias/"
				},
				{
					"title": "Vídeos",
					"tag": "Multimédia",
					"href": "/videos/"
				},
				{
					"title": "Podcasts",
					"tag": "Multimédia",
					"href": "/podcasts/"
				},
				{
					"title": "Galeria",
					"tag": "Multimédia",
					"href": "/galeria/"
				},
				{
					"title": "Plataformas",
					"tag": "Ferramenta",
					"href": "/ferramentas/plataformas/"
				},
				{
					"title": "Bases de dados",
					"tag": "Ferramenta",
					"href": "/bases-de-dados/"
				}
			]
		}
	},
	"editorScript": "getquick-nomia-blocks-editor",
	"editorStyle": "getquick-nomia-blocks-editor-style"
}
