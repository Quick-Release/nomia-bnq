{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/content-list",
	"title": "Lista de conteúdos",
	"category": "getquick-design",
	"icon": "playlist-audio",
	"description": "Lista de episódios com imagem, número, data e botões para ouvir e partilhar.",
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "content-list"
		},
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"title",
					"dateLabel",
					"imageSrc",
					"listenHref"
				],
				"properties": {
					"episodeNumber": {
						"type": "number"
					},
					"dateLabel": {
						"type": "string",
						"default": ""
					},
					"title": {
						"type": "string",
						"default": ""
					},
					"imageId": {
						"type": "number"
					},
					"imageSrc": {
						"type": "string",
						"default": ""
					},
					"imageAlt": {
						"type": "string",
						"default": ""
					},
					"listenHref": {
						"type": "string",
						"default": ""
					},
					"shareUrl": {
						"type": "string",
						"default": ""
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"items": [
				{
					"episodeNumber": 1,
					"dateLabel": "2 de Janeiro 2026",
					"title": "Episódio de teste para Gutenberg",
					"imageSrc": "/images/home/bioeconomia-intro/hero.jpg",
					"imageAlt": "Imagem de podcast",
					"listenHref": "#podcast-1",
					"shareUrl": "/podcasts/"
				}
			]
		}
	},
	"editorStyle": [
		"getquick-nomia-blocks-editor",
		"file:./editor.css"
	]
}
