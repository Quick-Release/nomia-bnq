{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/title-with-label",
	"title": "Título com etiqueta",
	"category": "getquick-nomia",
	"icon": "heading",
	"description": "Título de secção numa ou duas linhas, com uma etiqueta curta por cima.",
	"keywords": [
		"título",
		"etiqueta",
		"cabeçalho",
		"secção",
		"eyebrow"
	],
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "title-with-label"
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"titleLine1": {
			"type": "string",
			"default": ""
		},
		"titleLine2": {
			"type": "string",
			"default": ""
		},
		"level": {
			"type": "number",
			"default": 2
		},
		"typography": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"label": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"size": {
							"type": "string",
							"enum": [
								"extra",
								"notes",
								"body",
								"body-large",
								"subtitle",
								"h4",
								"h3",
								"h2",
								"h1",
								"large",
								"super"
							]
						},
						"lineHeight": {
							"type": "string",
							"enum": [
								"j",
								"i",
								"h",
								"g",
								"f",
								"e",
								"d",
								"c",
								"b",
								"a"
							]
						},
						"bold": {
							"type": "boolean"
						},
						"italic": {
							"type": "boolean"
						}
					}
				},
				"titleLine1": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"size": {
							"type": "string",
							"enum": [
								"extra",
								"notes",
								"body",
								"body-large",
								"subtitle",
								"h4",
								"h3",
								"h2",
								"h1",
								"large",
								"super"
							]
						},
						"lineHeight": {
							"type": "string",
							"enum": [
								"j",
								"i",
								"h",
								"g",
								"f",
								"e",
								"d",
								"c",
								"b",
								"a"
							]
						},
						"bold": {
							"type": "boolean"
						},
						"italic": {
							"type": "boolean"
						}
					}
				},
				"titleLine2": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"size": {
							"type": "string",
							"enum": [
								"extra",
								"notes",
								"body",
								"body-large",
								"subtitle",
								"h4",
								"h3",
								"h2",
								"h1",
								"large",
								"super"
							]
						},
						"lineHeight": {
							"type": "string",
							"enum": [
								"j",
								"i",
								"h",
								"g",
								"f",
								"e",
								"d",
								"c",
								"b",
								"a"
							]
						},
						"bold": {
							"type": "boolean"
						},
						"italic": {
							"type": "boolean"
						}
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"label": "Visão geral",
			"titleLine1": "A Economia Circular promove um modelo económico reorganizado,",
			"titleLine2": "através da coordenação dos sistemas de produção e consumo em circuitos fechados.",
			"typography": {
				"titleLine1": {
					"size": "h3",
					"lineHeight": "f",
					"bold": true
				}
			}
		}
	},
	"editorScript": "getquick-nomia-blocks-editor",
	"editorStyle": "getquick-nomia-blocks-editor-style"
}
