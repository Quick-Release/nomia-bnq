{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/page-hero-static",
	"title": "Cabeçalho página com imagem",
	"category": "getquick-nomia",
	"icon": "cover-image",
	"description": "Hero no topo da página com imagem de fundo, título, subtítulo e botão opcional.",
	"keywords": [
		"hero",
		"cabeçalho",
		"capa",
		"banner",
		"destaque"
	],
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "page-hero-static"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"showSubtitle": {
			"type": "boolean",
			"default": true
		},
		"imageId": {
			"type": "number"
		},
		"imageSrc": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"cta": {
			"type": "object"
		},
		"ctaLabel": {
			"type": "string",
			"default": ""
		},
		"showCta": {
			"type": "boolean",
			"default": false
		},
		"ctaHref": {
			"type": "string",
			"default": ""
		},
		"titleTextFontSize": {
			"type": "number"
		},
		"subtitleTextFontSize": {
			"type": "number"
		},
		"titleTextColor": {
			"type": "string",
			"default": ""
		},
		"subtitleTextColor": {
			"type": "string",
			"default": ""
		},
		"subtitleLineHeight": {
			"type": "string",
			"default": "default",
			"enum": [
				"default",
				"j",
				"i",
				"h",
				"g",
				"f",
				"e",
				"d",
				"c",
				"b",
				"a"
			]
		},
		"textAlign": {
			"type": "string",
			"default": "left",
			"enum": [
				"left",
				"center",
				"right"
			]
		},
		"height": {
			"type": "string",
			"default": "xl",
			"enum": [
				"xs",
				"s",
				"m",
				"l",
				"xl"
			]
		},
		"paddingTop": {
			"type": "string",
			"default": "default",
			"enum": [
				"default",
				"none",
				"small",
				"medium",
				"large"
			]
		},
		"paddingBottom": {
			"type": "string",
			"default": "default",
			"enum": [
				"default",
				"none",
				"small",
				"medium",
				"large"
			]
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"title": "Título vindo do WordPress",
			"subtitle": "Subtítulo editável no Gutenberg, renderizado pelo Astro.",
			"imageSrc": "/images/home/bioeconomia-intro/hero.jpg",
			"imageAlt": "Muda em mãos",
			"ctaLabel": "Saber Mais",
			"ctaHref": "/bioeconomia-sustentavel/",
			"showCta": true,
			"showSubtitle": true,
			"titleTextFontSize": 64,
			"subtitleTextFontSize": 28,
			"titleTextColor": "#ffffff",
			"subtitleTextColor": "#e5faf9",
			"textAlign": "left",
			"height": "xl"
		}
	},
	"editorScript": "getquick-nomia-blocks-editor",
	"editorStyle": "getquick-nomia-blocks-editor-style"
}
