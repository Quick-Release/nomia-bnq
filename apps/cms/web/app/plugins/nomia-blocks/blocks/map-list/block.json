{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/map-list",
	"title": "Mapa com lista",
	"category": "getquick-design",
	"icon": "location",
	"description": "Mapa de regiões com filtros por público e lista dos conteúdos de cada região.",
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "map-list"
		},
		"regions": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"id",
					"label"
				],
				"properties": {
					"id": {
						"type": "string",
						"default": ""
					},
					"label": {
						"type": "string",
						"default": ""
					}
				}
			}
		},
		"audiences": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"id",
					"label"
				],
				"properties": {
					"id": {
						"type": "string",
						"default": ""
					},
					"label": {
						"type": "string",
						"default": ""
					}
				}
			}
		},
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"title",
					"href",
					"imageSrc",
					"regionId",
					"audienceIds"
				],
				"properties": {
					"id": {
						"type": "string",
						"default": ""
					},
					"title": {
						"type": "string",
						"default": ""
					},
					"excerpt": {
						"type": "string",
						"default": ""
					},
					"dateLabel": {
						"type": "string",
						"default": ""
					},
					"imageId": {
						"type": "number"
					},
					"imageSrc": {
						"type": "string",
						"default": ""
					},
					"imageAlt": {
						"type": "string",
						"default": ""
					},
					"href": {
						"type": "string",
						"default": ""
					},
					"regionId": {
						"type": "string",
						"default": ""
					},
					"audienceIds": {
						"type": "array",
						"default": [],
						"items": {
							"type": "string",
							"default": ""
						}
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"regions": [
				{
					"id": "alentejo",
					"label": "Alentejo"
				}
			],
			"audiences": [
				{
					"id": "empresas",
					"label": "Empresas"
				}
			],
			"items": [
				{
					"id": "map-list-fixture",
					"title": "Iniciativa de teste",
					"excerpt": "Resumo curto vindo do WordPress.",
					"href": "#iniciativa",
					"dateLabel": "2026",
					"imageUrl": "/images/hero-carousel/economia-circular.jpg",
					"imageAlt": "Mapa",
					"regionId": "alentejo",
					"audienceIds": [
						"empresas"
					]
				}
			]
		}
	},
	"editorStyle": [
		"getquick-nomia-blocks-editor",
		"file:./editor.css"
	]
}
