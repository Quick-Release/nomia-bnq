{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/home-intro",
	"title": "Introdução da homepage",
	"category": "getquick-design",
	"icon": "admin-home",
	"description": "Introdução com etiqueta, título, texto, botão e imagem grande com legenda opcional.",
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "home-intro"
		},
		"eyebrowLabel": {
			"type": "string",
			"default": ""
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"accent": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"ctaHref": {
			"type": "string",
			"default": ""
		},
		"ctaLabel": {
			"type": "string",
			"default": ""
		},
		"showCta": {
			"type": "boolean",
			"default": false
		},
		"showTematica": {
			"type": "boolean",
			"default": false
		},
		"showCaption": {
			"type": "boolean",
			"default": false
		},
		"heroId": {
			"type": "number"
		},
		"heroSrc": {
			"type": "string",
			"default": ""
		},
		"heroAlt": {
			"type": "string",
			"default": ""
		},
		"captionHeading": {
			"type": "string",
			"default": ""
		},
		"captionBody": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"eyebrow": "NOMIA",
			"accent": "ciano",
			"heading": "Bioeconomia para um futuro sustentável",
			"body": "Conheça projetos, iniciativas e recursos para uma economia mais sustentável.",
			"ctaHref": "/bioeconomia-sustentavel/",
			"ctaLabel": "Explorar",
			"showCta": true,
			"showTematica": true,
			"showCaption": false,
			"heroSrc": "/images/home/bioeconomia-intro/hero.jpg",
			"heroAlt": "Muda em mãos"
		}
	},
	"editorStyle": [
		"getquick-nomia-blocks-editor",
		"file:./editor.css"
	]
}
