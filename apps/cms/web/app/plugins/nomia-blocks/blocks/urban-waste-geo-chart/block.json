{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "getquick/urban-waste-geo-chart",
	"title": "Gráfico geográfico de resíduos urbanos",
	"category": "getquick-design",
	"icon": "admin-site-alt3",
	"description": "Barras horizontais de resíduos urbanos por habitante, por região e ano, com anos filtráveis.",
	"textdomain": "getquick-nomia-blocks",
	"attributes": {
		"schemaVersion": {
			"type": "number",
			"default": 1
		},
		"blockId": {
			"type": "string",
			"default": "urban-waste-geo-chart"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"badge": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"summary": {
			"type": "string",
			"default": ""
		},
		"comparisonLabel": {
			"type": "string",
			"default": ""
		},
		"metricLabel": {
			"type": "string",
			"default": ""
		},
		"periodLabel": {
			"type": "string",
			"default": ""
		},
		"scopeLabel": {
			"type": "string",
			"default": ""
		},
		"regions": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"required": [
					"id",
					"label",
					"values"
				],
				"properties": {
					"id": {
						"type": "string",
						"default": ""
					},
					"label": {
						"type": "string",
						"default": ""
					},
					"values": {
						"type": "object"
					}
				}
			}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"align": false,
		"inserter": true
	},
	"example": {
		"attributes": {
			"title": "Resíduos urbanos por habitante",
			"badge": "2021–2024",
			"intro": "Comparação ilustrativa por localização geográfica.",
			"summary": "Valores de demonstração para o gráfico.",
			"comparisonLabel": "Localização vs resíduos urbanos",
			"metricLabel": "kg/habitante",
			"periodLabel": "Anual",
			"scopeLabel": "Portugal",
			"regions": [
				{
					"id": "pt",
					"label": "Portugal",
					"values": {
						"2021": 349,
						"2022": 735,
						"2023": 876,
						"2024": 787
					}
				},
				{
					"id": "cont",
					"label": "Continente",
					"values": {
						"2021": 680,
						"2022": 956,
						"2023": 735,
						"2024": 720
					}
				},
				{
					"id": "norte",
					"label": "Norte",
					"values": {
						"2021": 735,
						"2022": 1000,
						"2023": 959,
						"2024": 915
					}
				}
			]
		}
	},
	"editorStyle": "getquick-nomia-blocks-editor"
}
