# Local DDEV database. These values are intentionally local-only.
DB_NAME='db'
DB_USER='db'
DB_PASSWORD='db'
DB_HOST='db'
DB_PREFIX='wp_'

# Bedrock / WordPress URLs
WP_ENV='development'
WP_ENVIRONMENT_TYPE='local'
WP_HOME='https://nomia-bnq-admin.ddev.site'
WP_SITEURL="${WP_HOME}/wp"

# Useful diagnostics for local development.
GRAPHQL_DEBUG='true'
GRAPHQL_CORS_ORIGINS='http://localhost:4321,https://localhost:4321'
# The Astro dev server; WordPress permalinks point here.
GETQUICK_FRONTEND_URL='http://localhost:4321'

# Media: local uploads stay on disk (never set R2 credentials locally, they
# would write to the live bucket). Once gq.ops.json has media.domain,
# `pnpm cms:dev` adds S3_UPLOADS_BUCKET_URL so synced media missing locally is
# served from the bucket.
DISABLE_WP_CRON='false'

# Local-only salts. Replace every value before using this file for production.
AUTH_KEY='nomia-bnq-local-auth-key'
SECURE_AUTH_KEY='nomia-bnq-local-secure-auth-key'
LOGGED_IN_KEY='nomia-bnq-local-logged-in-key'
NONCE_KEY='nomia-bnq-local-nonce-key'
AUTH_SALT='nomia-bnq-local-auth-salt'
SECURE_AUTH_SALT='nomia-bnq-local-secure-auth-salt'
LOGGED_IN_SALT='nomia-bnq-local-logged-in-salt'
NONCE_SALT='nomia-bnq-local-nonce-salt'
