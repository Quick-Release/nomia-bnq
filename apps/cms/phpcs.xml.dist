<?xml version="1.0"?>
<ruleset name="Nomia First-Party CMS Plugins">
    <description>WordPress Coding Standards and PHP compatibility for nomia-bnq's own CMS plugins.</description>

    <file>web/app/plugins/nomia-cpt</file>

    <!-- The translation catalogs aren't authored PHP. -->
    <exclude-pattern>*/languages/*</exclude-pattern>

    <!-- WordPress is the complete WPCS ruleset (Core, Docs, and Extra). -->
    <rule ref="WordPress" />
    <rule ref="PHPCompatibilityWP" />

    <!-- nomia-cpt registers these custom capabilities during activation and upgrades. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_nomia_cpt_galleries" />
                <element value="edit_nomia_cpt_libraries" />
            </property>
        </properties>
    </rule>

    <!-- nomia-cpt requires PHP 8.4. -->
    <config name="testVersion" value="8.4-" />

    <arg name="basepath" value="." />
    <arg name="extensions" value="php" />
</ruleset>
