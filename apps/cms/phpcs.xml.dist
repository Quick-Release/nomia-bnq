<?xml version="1.0"?>
<ruleset name="Nomia First-Party CMS Plugins">
    <description>WordPress Coding Standards and PHP compatibility for nomia-bnq's own CMS plugin.</description>

    <!--
        The Composer plugin that registers these standards doesn't run in CI
        (Composer disables plugins as root), so the ruleset names them itself,
        relative to squizlabs/php_codesniffer as PHPCS resolves them.
    -->
    <config name="installed_paths" value="../../phpcompatibility/php-compatibility,../../phpcompatibility/phpcompatibility-paragonie,../../phpcompatibility/phpcompatibility-wp,../../phpcsstandards/phpcsextra,../../phpcsstandards/phpcsutils,../../wp-coding-standards/wpcs" />

    <file>web/app/plugins/gq-bioeconomia</file>

    <!-- The translation catalogs aren't authored PHP. -->
    <exclude-pattern>*/languages/*</exclude-pattern>
    <!--
        gq-bioeconomia's tests and their WordPress stubs, its local test
        dependencies, and what is generated: the block metadata and the
        contracts apps/frontend's structured-blocks:sync writes.
    -->
    <exclude-pattern>*/gq-bioeconomia/tests/*</exclude-pattern>
    <exclude-pattern>*/gq-bioeconomia/vendor/*</exclude-pattern>
    <exclude-pattern>*/gq-bioeconomia/blocks/*</exclude-pattern>
    <exclude-pattern>*/gq-bioeconomia/src/Contracts.php</exclude-pattern>

    <!-- WordPress is the complete WPCS ruleset (Core, Docs, and Extra). -->
    <rule ref="WordPress">
        <!-- gq-bioeconomia follows GQ Design's PHP: short arrays. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax" />
    </rule>
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <exclude-pattern>*/gq-bioeconomia/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax">
        <include-pattern>*/gq-bioeconomia/*</include-pattern>
    </rule>

    <!--
        Like GQ Design's, gq-bioeconomia's namespaced PSR-4 classes in src/ keep
        camelCase APIs and PascalCase file names.
    -->
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <exclude-pattern>*/gq-bioeconomia/src/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
        <exclude-pattern>*/gq-bioeconomia/src/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>*/gq-bioeconomia/src/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>*/gq-bioeconomia/src/*</exclude-pattern>
    </rule>
    <rule ref="PHPCompatibilityWP" />

    <!-- gq-bioeconomia registers these custom capabilities during activation and upgrades. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_gq_bioeconomia_galleries" />
                <element value="edit_gq_bioeconomia_libraries" />
            </property>
        </properties>
    </rule>

    <!-- gq-bioeconomia requires PHP 8.4. -->
    <config name="testVersion" value="8.4-" />

    <arg name="basepath" value="." />
    <arg name="extensions" value="php" />
</ruleset>
